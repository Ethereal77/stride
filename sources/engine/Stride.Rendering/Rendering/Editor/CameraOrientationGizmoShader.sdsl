shader CameraOrientationGizmoShader  : ComputeColor, PositionStream4
{
    override float4 Compute()
    {
        float yPosRemapped = pow((streams.PositionWS.y + 1) / 2, 3.5f);
        return float4(0.6f, 0.6f, 0.6f, 1.0f) * yPosRemapped;
    }
};
